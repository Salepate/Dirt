<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mud.Server</PackageId>
    <AssemblyName>Mud.Server</AssemblyName>
    <Version>1.1.0</Version>
    <Authors>Salepate</Authors>
    <Title>Mud.Server</Title>
    <Description>Network socket thread handler for Mud</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Salepate</Copyright>
    <PackageTags>Dirt.Framework</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <DefineConstants>USE_WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Dirt\Log\Log.csproj" />
    <ProjectReference Include="..\Mud\Mud.csproj" />
  </ItemGroup>
</Project>
