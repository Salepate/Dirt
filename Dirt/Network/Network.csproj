<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>Dirt.Network</AssemblyName>
    <PackageId>Dirt.Network</PackageId>
    <Product>Dirt.Network</Product>
    <Version>1.1.0</Version>
    <Authors>Salepate</Authors>
    <Title>Dirt Network</Title>
    <Description>UDP/TCP networking layer built on Mud and Simulation</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
