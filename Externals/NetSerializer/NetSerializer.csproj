<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mud.$(AssemblyName)</PackageId>
    <Version>1.1.0</Version>
    <Authors>tomba</Authors>
    <Title>NetSerializer</Title>
    <Description>Efficient binary serializer by @tomba (https://github.com/tomba/netserializer), repackaged for Dirt</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>tomba</Copyright>
    <PackageTags>Dirt.Framework</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);NO_UNSAFE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);NO_UNSAFE</DefineConstants>
  </PropertyGroup>

</Project>
